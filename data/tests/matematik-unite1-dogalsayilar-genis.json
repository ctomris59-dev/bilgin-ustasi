    { "id": "q49", "text": "90 ÷ 4 işleminde bölüm ve kalan nedir?", "options": ["Bölüm 21, kalan 2", "Bölüm 22, kalan 2", "Bölüm 22, kalan 1", "Bölüm 23, kalan 0"], "correctIndex": 1, "hint": "4×22=88, kalanı bul." },
    { "id": "q50", "text": "288 ÷ 12 işleminin sonucu kaçtır?", "options": ["22", "23", "24", "25"], "correctIndex": 2, "hint": "12×24'ü kontrol et." },
    { "id": "q51", "text": "6² (6'nın karesi) kaçtır?", "options": ["12", "36", "18", "24"], "correctIndex": 1, "hint": "6×6 işlemini yap." },
    { "id": "q52", "text": "9² (9'un karesi) kaçtır?", "options": ["18", "72", "81", "90"], "correctIndex": 2, "hint": "9×9 işlemini yap." },
