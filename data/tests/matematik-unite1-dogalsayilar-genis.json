    { "id": "q28", "text": "834 - 567 işleminin sonucu kaçtır?", "options": ["277", "267", "257", "247"], "correctIndex": 1, "hint": "Onlar basamağında bozma gerekebilir." },
    { "id": "q29", "text": "25.000 - 17.850 işleminin sonucu kaçtır?", "options": ["7.150", "7.250", "7.050", "8.150"], "correctIndex": 0, "hint": "Basamak basamak dikkatli çıkar." },
    { "id": "q30", "text": "6.000 - 2.345 işleminin sonucu kaçtır?", "options": ["3.655", "3.755", "3.565", "3.645"], "correctIndex": 0, "hint": "Sıfırlı sayıdan çıkarırken zincirleme bozma yaparsın." },
    { "id": "q31", "text": "24 × 15 işleminin sonucu kaçtır?", "options": ["340", "360", "350", "380"], "correctIndex": 1, "hint": "24×10=240, 24×5=120, topla." },
    { "id": "q32", "text": "125 × 8 işleminin sonucu kaçtır?", "options": ["900", "1.000", "1.100", "950"], "correctIndex": 1, "hint": "125×8, 100×8 ve 25×8'i ayrı ayrı düşün." },
