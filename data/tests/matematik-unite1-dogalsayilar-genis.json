    { "id": "q66", "text": "(8 + 2) × (9 - 4) işleminin sonucu kaçtır?", "options": ["40", "45", "50", "55"], "correctIndex": 2, "hint": "İki parantezi ayrı ayrı çöz, sonra çarp." },
    { "id": "q67", "text": "Zorlayıcı problem: Bir markette 24 kasa elma var, her kasada 18 elma bulunuyor. Toplam kaç elma vardır?", "options": ["402", "422", "432", "442"], "correctIndex": 2, "hint": "24 × 18 işlemini yap." },
