    { "id": "q75", "text": "Zorlayıcı problem: 250 öğrenci bir yarışmada 25'erli gruplara ayrılıyor. Kaç grup oluşur?", "options": ["8", "9", "10", "11"], "correctIndex": 2, "hint": "250 ÷ 25 işlemini yap." },
    { "id": "q76", "text": "Zorlayıcı problem: Bir otoparkta 112 araç kapasitesi var. Şu an 95 araç park etmiş. 37 araba daha gelirse kaç araba yer bulamaz?", "options": ["15", "20", "17", "22"], "correctIndex": 1, "hint": "Önce boş yer sayısını bul (112-95), sonra 37'den çıkar." },
    { "id": "q77", "text": "Zorlayıcı problem: Bir çiftçi 3 tarlaya elma ağacı dikiyor. Her tarlada 45 ağaç var, her ağaçtan 25 elma toplanıyor. Toplam kaç elma toplanır?", "options": ["3.175", "3.275", "3.375", "3.475"], "correctIndex": 2, "hint": "3 × 45 × 25 işlemini sırayla yap." },
