      "hint": "'see' fiilinin 3. hali (past participle) 'seen'dir."
    },
    {
      "id": "q4",
      "text": "They _____ in this city since 2015.",
      "options": ["live", "lived", "have lived", "living"],
      "correctIndex": 2,
      "hint": "'since' ile Present Perfect kullanılır."
    },
    {
      "id": "q5",
      "text": "'Have you ever eaten sushi?' sorusuna en uygun cevap hangisidir?",
      "options": ["Yes, I eat.", "Yes, I have.", "Yes, I did.", "Yes, I ate."],
      "correctIndex": 1,
      "hint": "Kısa cevaplarda 'have/has' tekrar edilir."
    },
    {
      "id": "q6",
      "text": "We _____ our project yet.",
      "options": ["haven't finished", "didn't finish", "don't finish", "not finished"],
      "correctIndex": 0,
      "hint": "'yet' genellikle Present Perfect olumsuz cümlelerde kullanılır."
    }
