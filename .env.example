# Bu değerleri Vercel Dashboard > Project > Settings > Environment Variables kısmına gir.
# Yerel geliştirmede kullanmak istersen bu dosyayı .env.local olarak kopyala.

# GitHub Personal Access Token (fine-grained, sadece bu repoya "Contents: Read and write" izni ile)
GITHUB_TOKEN=github_pat_xxx

# Verilerin tutulacağı GitHub kullanıcı adı / organizasyon
GITHUB_OWNER=kullanici-adin

# Repo adı (bu projeyi yüklediğin repo)
GITHUB_REPO=bilgin-ustasi

# Opsiyonel, varsayılan "main"
GITHUB_BRANCH=main

# Ebeveyn panelini korumak için kendi belirleyeceğin bir şifre/anahtar
PARENT_ACCESS_KEY=guclu-bir-sifre-belirle
